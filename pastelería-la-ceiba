<script>
/* ======================= DATOS ======================= */
const PRODUCTS = [
  {id:'tres-leches', name:'Pastel Tres Leches', cat:'Pasteles', shape:'cake', colors:['#F6E7C8','#FFFDF8','#C9853F'], tag:'Más vendido', stock:14, msg:true,
