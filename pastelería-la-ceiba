        return `<div class="line" data-key="${esc(l.key)}">
          <div class="thumb">${art(p)}</div>
          <div><h3>${esc(l.name)}</h3><div class="meta">${l.sizeLabel} · ${l.detail} · ${money(l.price)} c/u</div>
            ${l.msg?`<div class="meta">✍️ “${esc(l.msg)}”</div>`:''}
            <div class="ctrl">
              <div class="qty sm"><button data-a="minus" aria-label="Restar" ${l.qty<=1?'disabled':''}>−</button><input data-a="input" type="number" min="1" value="${l.qty}" aria-label="Cantidad de ${esc(l.name)}"><button data-a="plus" aria-label="Sumar" ${l.qty>=max?'disabled':''}>+</button></div>
              <button class="remove" data-a="remove">Eliminar</button>
              ${l.qty>=max?`<span style="font-size:.8rem;color:var(--aviso)">Máximo disponible</span>`:''}
            </div></div>
          <div class="cost"><b>${money(r2(l.price*l.qty))}</b><span>${l.qty} × ${money(l.price)}</span></div>
        </div>`;}).join('')}
      <a href="#/" class="btn btn-ghost" style="margin-top:14px">← Seguir comprando</a>
    </div>
    <aside class="card panel sticky">
      ${summaryHTML({footer:`
        <form class="coupon" id="couponForm"><input id="couponIn" placeholder="Código de cupón" aria-label="Código de cupón" ${state.coupon?'disabled':''} value="${state.coupon||''}"><button class="btn btn-ghost" type="submit">${state.coupon?'Quitar':'Aplicar'}</button></form>
        <div id="couponMsg">${t.couponError?alertHTML('warn',t.couponError):state.coupon?alertHTML('ok',`Cupón <b>${state.coupon}</b> aplicado: ${COUPONS[state.coupon].label}.`):'<div class="sum-note">Prueba con <b>CEIBA10</b> o <b>BIENVENIDA</b>.</div>'}</div>
        <a href="#/datos" class="btn btn-primary btn-block" style="margin-top:14px">Continuar con la entrega →</a>`})}
    </aside></div>`;

  $$('#carrito .line').forEach(row => {
    const key = row.dataset.key, l = state.cart.find(x=>x.key===key), p = byId(l.id);
    const max = () => p.stock - stockUsed(l.id, l.key);
    row.querySelectorAll('[data-a]').forEach(el => {
      const a = el.dataset.a;
      if (a==='minus') el.onclick = () => { l.qty--; commit(); };
      if (a==='plus') el.onclick = () => { if (l.qty+1>max()) return toast(`Solo hay ${max()} unidades disponibles.`,'error'); l.qty++; commit(); };
      if (a==='input') el.onchange = e => { let v=parseInt(e.target.value,10); if(isNaN(v)||v<1) v=1; if(v>max()){ toast(`Solo hay ${max()} unidades de ${p.name}. Ajustamos la cantidad.`,'error'); v=max(); } l.qty=v; commit(); };
      if (a==='remove') el.onclick = () => {
        const idx = state.cart.indexOf(l); state.cart.splice(idx,1); commit();
        toast(`${l.name} eliminado`,'',{label:'Deshacer',fn:()=>{state.cart.splice(idx,0,l);commit();}});
      };
    });
  });
  $('#emptyCart').onclick = () => {
    if (!confirm('¿Seguro que quieres vaciar el carrito?')) return;
