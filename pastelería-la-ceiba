const fDatos = $('#formDatos');
function tomorrow(){ const d=new Date(); d.setDate(d.getDate()+1); return d.toISOString().slice(0,10); }
function initDatos(){
  const o = state.order;
  $('#f-fecha').min = tomorrow();
  if (o.metodo) $('#m-'+o.metodo).checked = true;
  [['nombre','f-nombre'],['tel','f-tel'],['email','f-email'],['dir','f-dir'],['muni','f-muni'],['ref','f-ref'],['fecha','f-fecha'],['hora','f-hora'],['notas','f-notas']].forEach(([k,id])=>{ if(o[k]!==undefined) $('#'+id).value = o[k]; });
  toggleDir();
  $('#datosAlert').innerHTML = '';
  $('#sumDatos').innerHTML = summaryHTML({items:true});
}
function toggleDir(){ $('#fsDireccion').hidden = state.order.metodo !== 'domicilio'; }
$$('input[name=metodo]').forEach(r => r.onchange = () => { state.order.metodo = r.value; setValid('metodo',true); save(); toggleDir(); $('#sumDatos').innerHTML = summaryHTML({items:true}); });
$('#f-tel').oninput = e => { let v=e.target.value.replace(/\D/g,'').slice(0,8); e.target.value = v.length>4 ? v.slice(0,4)+'-'+v.slice(4) : v; };
function setValid(f, ok, msgEl, msg){
  const el = document.querySelector(`[data-f="${f}"]`); if(!el) return ok;
  el.classList.toggle('invalid', !ok); el.classList.toggle('valid', ok);
  if (msgEl && msg) $(msgEl).textContent = msg;
  return ok;
}
const datosRules = {
  nombre: () => setValid('nombre', $('#f-nombre').value.trim().split(/\s+/).filter(w=>w.length>1).length >= 2),
  tel: () => setValid('tel', /^[267]\d{3}-\d{4}$/.test($('#f-tel').value)),
  email: () => setValid('email', /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test($('#f-email').value.trim())),
  dir: () => state.order.metodo!=='domicilio' || setValid('dir', $('#f-dir').value.trim().length >= 8),
  muni: () => {
    if (state.order.metodo!=='domicilio') return true;
    const v = $('#f-muni').value;
    if (!v) return setValid('muni', false, '#muniErr', 'Selecciona un municipio.');
    if (v==='fuera') return setValid('muni', false, '#muniErr', 'Lo sentimos, aún no hacemos envíos a esa zona. Elige retiro en tienda.');
    return setValid('muni', true);
  },
  fecha: () => {
    const v = $('#f-fecha').value;
    if (!v) return setValid('fecha', false, '#fechaErr', 'Elige una fecha.');
    if (v < tomorrow()) return setValid('fecha', false, '#fechaErr', 'Los pedidos requieren al menos 24 h de anticipación.');
    if (new Date(v+'T12:00').getDay()===0 && state.order.metodo==='domicilio') return setValid('fecha', false, '#fechaErr', 'No hacemos envíos los domingos. Elige otro día o retiro en tienda.');
    return setValid('fecha', true);
  },
  hora: () => setValid('hora', !!$('#f-hora').value)
};
const map = {nombre:'f-nombre',tel:'f-tel',email:'f-email',dir:'f-dir',muni:'f-muni',fecha:'f-fecha',hora:'f-hora'};
Object.entries(map).forEach(([k,id]) => {
  const el = $('#'+id);
  el.addEventListener('blur', () => { if (el.value) datosRules[k](); });
  el.addEventListener('change', () => datosRules[k]());
});
fDatos.onsubmit = e => {
  e.preventDefault();
  let ok = setValid('metodo', !!state.order.metodo);
  for (const k in datosRules) ok = datosRules[k]() && ok;
  if (!ok){
    $('#datosAlert').innerHTML = alertHTML('error','<b>Revisa los campos marcados</b> para continuar.');
    const first = fDatos.querySelector('.invalid input, .invalid select'); if (first) first.focus();
    window.scrollTo({top:0,behavior:'smooth'});
    return;
  }
  Object.assign(state.order, {
    nombre:$('#f-nombre').value.trim(), tel:$('#f-tel').value, email:$('#f-email').value.trim(),
    dir:$('#f-dir').value.trim(), muni:$('#f-muni').value, ref:$('#f-ref').value.trim(),
    fecha:$('#f-fecha').value, hora:$('#f-hora').value, notas:$('#f-notas').value.trim(), ok:true
  });
  save(); location.hash = '#/pago';
};

