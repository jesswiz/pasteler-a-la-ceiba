  {id:'cheesecake', name:'Cheesecake de Fresa', cat:'Postres', shape:'slice', colors:['#FFF4DC','#D9465F','#C9A26B'], tag:'Nuevo', stock:10, msg:false,
   desc:'Base de galleta y mantequilla, crema de queso horneada y coulis de fresas frescas.',
   sizes:[{id:'p',label:'Porción',detail:'1 persona',price:3.75},{id:'m',label:'Entero',detail:'10 porciones',price:30.00}]},
  {id:'quesadilla', name:'Quesadilla Salvadoreña', cat:'Pan dulce', shape:'bread', colors:['#E2A65A','#F5D08A','#B97A33'], stock:30, msg:false,
   desc:'Receta tradicional con queso duro, crema y ajonjolí tostado en la superficie.',
   sizes:[{id:'p',label:'Porción',detail:'1 pieza',price:1.25},{id:'m',label:'Molde completo',detail:'12 piezas',price:13.50}]},
  {id:'semita', name:'Semita Alta', cat:'Pan dulce', shape:'bread', colors:['#C98A4B','#E8B76F','#7A3E1D'], stock:20, msg:false,
   desc:'Masa suave rellena de dulce de piña y atado, horneada hasta dorar.',
   sizes:[{id:'p',label:'Pieza',detail:'1 unidad',price:1.50},{id:'m',label:'Bandeja',detail:'8 piezas',price:10.50}]},
  {id:'conchas', name:'Caja de Pan Dulce', cat:'Pan dulce', shape:'bread', colors:['#E9C189','#FFF0DA','#E8B4A0'], stock:12, msg:false,
   desc:'Surtido de conchas, salpores y cuernitos horneados esta mañana.',
   sizes:[{id:'m',label:'Media docena',detail:'6 piezas',price:5.00},{id:'g',label:'Docena',detail:'12 piezas',price:9.00}]},
  {id:'maracuya', name:'Tarta de Maracuyá', cat:'Postres', shape:'tart', colors:['#E9C27A','#F4B400','#5E3C1E'], stock:0, msg:false,
   desc:'Masa quebrada con crema de maracuyá y semillas. Disponible de nuevo el fin de semana.',
   sizes:[{id:'p',label:'Porción',detail:'1 persona',price:3.50},{id:'m',label:'Entera',detail:'8 porciones',price:26.00}]}
];
const COUPONS = {
  'CEIBA10':{type:'pct', value:.10, label:'10 % de descuento'},
  'BIENVENIDA':{type:'fix', value:5, min:20, label:'$5 de descuento en compras desde $20'}
};
const ENVIO = 3.50, ENVIO_GRATIS = 40, IVA = .13;

/* ======================= ESTADO ======================= */
const store = {
  get(k,d){try{const v=localStorage.getItem('ceiba_'+k);return v?JSON.parse(v):d}catch(e){return d}},
  set(k,v){try{localStorage.setItem('ceiba_'+k,JSON.stringify(v))}catch(e){}}
};
const state = {
  cart: store.get('cart', []),
  coupon: store.get('coupon', null),
  order: store.get('order', {}),
  filter: 'Todos', query: '',
  lastOrder: null, lastError: null,
  detail: {size:null, qty:1, msg:''}
};
const save = () => { store.set('cart',state.cart); store.set('coupon',state.coupon); store.set('order',state.order); };

/* ======================= UTILIDADES ======================= */
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const money = n => new Intl.NumberFormat('es-SV',{style:'currency',currency:'USD'}).format(n);
const r2 = n => Math.round(n*100)/100;
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const byId = id => PRODUCTS.find(p => p.id === id);
const icons = {
  err:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 7v6M12 17h.01"/></svg>',
  ok:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>',
  info:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 11v6M12 7h.01"/></svg>'
};
const alertHTML = (type, html) => `<div class="alert ${type}" role="${type==='error'?'alert':'status'}">${icons[type==='error'||type==='warn'?'err':type==='ok'?'ok':'info']}<div>${html}</div></div>`;

function toast(msg, type='', action){
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.innerHTML = `<span>${msg}</span>` + (action ? `<button>${action.label}</button>` : '');
  if (action) t.querySelector('button').onclick = () => { action.fn(); t.remove(); };
  $('#toasts').appendChild(t);
  setTimeout(() => t.remove(), 3800);
}

/* ======================= ILUSTRACIONES ======================= */
function art(p){
  const [a,b,c] = p.colors;
  const shadow = '<ellipse cx="100" cy="142" rx="80" ry="9" fill="rgba(30,27,22,.10)"/>';
  if (p.shape === 'cake'){
    let drips=''; for(let i=0;i<7;i++){ drips += `<rect x="${34+i*19}" y="66" width="12" height="${14+((i*7)%11)}" rx="6" fill="${b}"/>`; }
    return `<svg viewBox="0 0 200 160" aria-hidden="true">${shadow}
      <rect x="30" y="70" width="140" height="68" rx="10" fill="${a}"/>
      <rect x="30" y="102" width="140" height="7" fill="${c}" opacity=".5"/>
      <rect x="30" y="66" width="140" height="10" rx="5" fill="${b}"/>${drips}
      <ellipse cx="100" cy="66" rx="70" ry="13" fill="${b}"/>
      <circle cx="70" cy="58" r="7" fill="${c}"/><circle cx="100" cy="53" r="8" fill="${c}"/><circle cx="130" cy="58" r="7" fill="${c}"/>
      <path d="M100 45v-12" stroke="#1F4D3A" stroke-width="3" stroke-linecap="round"/><path d="M100 32c4-4 9-3 10 0-4 3-8 3-10 0" fill="#5E9A77"/></svg>`;
  }
  if (p.shape === 'slice'){
    return `<svg viewBox="0 0 200 160" aria-hidden="true">${shadow}
      <path d="M30 130 L170 130 L170 82 L60 52 Z" fill="${a}"/>
      <path d="M30 130 L170 130 L170 116 L30 116 Z" fill="${c}"/>
      <path d="M60 52 L170 82 L170 92 Q150 104 140 90 Q125 102 112 86 Q98 98 88 76 Q72 84 66 66 Z" fill="${b}"/>
      <circle cx="120" cy="62" r="10" fill="${b}"/><path d="M118 52c2-5 6-6 8-4" stroke="#5E9A77" stroke-width="3" fill="none" stroke-linecap="round"/></svg>`;
  }
  if (p.shape === 'tart'){
    return `<svg viewBox="0 0 200 160" aria-hidden="true">${shadow}
      <path d="M22 96 L36 132 H164 L178 96 Z" fill="${a}"/>
      <ellipse cx="100" cy="96" rx="78" ry="20" fill="${a}"/>
      <ellipse cx="100" cy="94" rx="66" ry="15" fill="${b}"/>
      ${[[80,92],[100,98],[120,90],[92,86],[112,100],[130,96],[70,98]].map(([x,y])=>`<circle cx="${x}" cy="${y}" r="2.6" fill="${c}"/>`).join('')}</svg>`;
  }
  return `<svg viewBox="0 0 200 160" aria-hidden="true">${shadow}
    <path d="M28 134 Q28 58 100 58 Q172 58 172 134 Z" fill="${a}"/>
    <path d="M40 116 Q42 70 100 68 Q158 70 160 116 Q100 126 40 116 Z" fill="${b}"/>
    <path d="M62 84 L92 116 M86 72 L124 118 M114 70 L146 106 M138 78 L76 118 M112 72 L56 106 M150 96 L118 120" stroke="${c}" stroke-width="3" stroke-linecap="round" opacity=".55"/></svg>`;
}

/* ======================= CÁLCULOS ======================= */
function totals(){
  const sub = r2(state.cart.reduce((s,l)=>s+l.price*l.qty,0));
  const count = state.cart.reduce((s,l)=>s+l.qty,0);
  let disc = 0, couponError = null;
  if (state.coupon){
    const c = COUPONS[state.coupon];
    if (c.type==='pct') disc = r2(sub*c.value);
    else if (sub >= c.min) disc = Math.min(c.value, sub);
    else couponError = `El cupón ${state.coupon} requiere una compra mínima de ${money(c.min)}.`;
  }
  const base = r2(sub - disc);
  let envio = null;
  if (state.order.metodo === 'tienda') envio = 0;
  if (state.order.metodo === 'domicilio') envio = base >= ENVIO_GRATIS ? 0 : ENVIO;
  const total = r2(base + (envio || 0));
  const iva = r2(total - total/(1+IVA));
  return {sub, count, disc, envio, total, iva, couponError};
}
const stockUsed = (id, exceptKey) => state.cart.filter(l=>l.id===id && l.key!==exceptKey).reduce((s,l)=>s+l.qty,0);

/* ======================= HEADER ======================= */
function updateBadge(bump){
  const n = totals().count, b = $('#cartCount');
  b.textContent = n;
  if (bump){ b.classList.remove('bump'); void b.offsetWidth; b.classList.add('bump'); }
}
$('#cartBtn').onclick = () => location.hash = '#/carrito';

/* ======================= STEPPER ======================= */
function renderSteppers(){
  const labels = ['Carrito','Entrega','Pago','Confirmación'];
  $$('.stepper').forEach(el => {
    const cur = +el.dataset.step;
    el.innerHTML = labels.map((l,i)=>{
      const n=i+1, cls = n<cur ? 'done' : n===cur ? 'now' : '';
      return `<div class="step ${cls}" ${n===cur?'aria-current="step"':''}><span class="n">${n<cur?'✓':n}</span>${l}</div>`;
    }).join('');
  });
}

/* ======================= CATÁLOGO ======================= */
function renderCatalog(){
  const cats = ['Todos', ...new Set(PRODUCTS.map(p=>p.cat))];
  $('#chips').innerHTML = cats.map(c=>`<button class="chip ${state.filter===c?'on':''}" role="tab" aria-selected="${state.filter===c}" data-cat="${c}">${c}</button>`).join('');
  $$('#chips .chip').forEach(b => b.onclick = () => { state.filter = b.dataset.cat; renderCatalog(); });
  const q = state.query.trim().toLowerCase();
  const list = PRODUCTS.filter(p => (state.filter==='Todos' || p.cat===state.filter) && (!q || (p.name+' '+p.desc).toLowerCase().includes(q)));
  if (!list.length){ $('#grid').innerHTML = `<div class="empty-search card" style="grid-column:1/-1">No encontramos productos para “${esc(state.query)}”. <button class="link" id="clearQ">Limpiar búsqueda</button></div>`; $('#clearQ').onclick=()=>{state.query='';$('#search').value='';renderCatalog();}; return; }
  $('#grid').innerHTML = list.map(p => {
    const min = Math.min(...p.sizes.map(s=>s.price)), out = p.stock===0;
    return `<article class="card prod ${out?'soldout':''}" tabindex="0" data-id="${p.id}" aria-label="${p.name}">
      <div class="art">${art(p)}${out?'<span class="tag out">Agotado</span>':p.tag?`<span class="tag">${p.tag}</span>`:''}</div>
      <div class="body"><h3>${p.name}</h3><p class="desc">${p.desc}</p>
        <div class="foot"><span class="price"><small>desde </small>${money(min)}</span>
