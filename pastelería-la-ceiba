    if (!COUPONS[code]){ $('#couponMsg').innerHTML = alertHTML('error',`El cupón <b>${esc(code)}</b> no existe o ya venció.`); $('#couponIn').focus(); return; }
    const c = COUPONS[code];
    if (c.min && totals().sub < c.min){ $('#couponMsg').innerHTML = alertHTML('error',`<b>${code}</b> requiere una compra mínima de ${money(c.min)}.`); return; }
    state.coupon = code; commit(); toast('Cupón aplicado','ok');
  };
  function commit(){ save(); updateBadge(); renderCart(); }
}

