  {id:'chocolate', name:'Pastel de Chocolate', cat:'Pasteles', shape:'cake', colors:['#6B3E26','#3B2015','#E7B7A5'], stock:9, msg:true,
   desc:'Capas de bizcocho de cacao con relleno de ganache y cobertura de chocolate semiamargo.',
