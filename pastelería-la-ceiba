});
const pagoRules = {
  cnum: () => { const d=$('#c-num').value.replace(/\s/g,''); return setValid('cnum', d.length===16 && luhn(d)); },
  cname: () => setValid('cname', $('#c-name').value.trim().length >= 4),
  cexp: () => {
    const v=$('#c-exp').value, m=v.match(/^(\d{2})\/(\d{2})$/);
    if (!m || +m[1]<1 || +m[1]>12) return setValid('cexp', false, '#expErr', 'Usa el formato MM/AA.');
    const exp = new Date(2000+ +m[2], +m[1], 0, 23, 59);
    if (exp < new Date()) return setValid('cexp', false, '#expErr', 'La tarjeta está vencida.');
    return setValid('cexp', true);
  },
  ccvv: () => setValid('ccvv', /^\d{3,4}$/.test($('#c-cvv').value))
};
['cnum','cname','cexp','ccvv'].forEach(k => { const id={cnum:'c-num',cname:'c-name',cexp:'c-exp',ccvv:'c-cvv'}[k]; $('#'+id).addEventListener('blur', e => { if(e.target.value) pagoRules[k](); }); });

fPago.onsubmit = e => {
  e.preventDefault();
  const m = fPago.pago.value, t = totals();
  let ok = true;
  if (m==='tarjeta') for (const k in pagoRules) ok = pagoRules[k]() && ok;
  else {
    const v = $('#e-cambio').value.trim();
    if (v){ const n = parseFloat(v.replace(',','.')); ok = setValid('cambio', !isNaN(n) && n >= t.total, '#cambioErr', `El monto debe ser de al menos ${money(t.total)}.`) && ok; }
    else setValid('cambio', true);
  }
  const terms = $('#terms').checked;
  const tf = document.querySelector('[data-f="terms"] .err'); tf.style.display = terms ? 'none' : 'block';
  ok = terms && ok;
  if (!ok){
    $('#pagoAlert').innerHTML = alertHTML('error','<b>No pudimos procesar el formulario.</b> Corrige los campos marcados en rojo.');
    window.scrollTo({top:0,behavior:'smooth'}); return;
  }
  process(m);
};

function process(method){
  const card = $('#c-num').value.replace(/\s/g,'');
  const steps = method==='tarjeta' ? ['Validando datos de la tarjeta','Contactando al banco emisor','Confirmando el pedido'] : ['Verificando disponibilidad','Reservando tu pedido','Confirmando el pedido'];
  $('#procT').textContent = method==='tarjeta' ? 'Procesando tu pago' : 'Confirmando tu pedido';
  $('#overlay').classList.add('on');
  let i = 0;
  const paint = () => $('#procSteps').innerHTML = steps.map((s,k)=>`<div class="${k<i?'d':''}">${k<i?'✓':k===i?'⏳':'○'} ${s}</div>`).join('');
  paint();
  const iv = setInterval(() => { i++; paint(); }, 700);
  setTimeout(() => {
    clearInterval(iv); $('#overlay').classList.remove('on');
    // Revalida stock (simula que otro cliente compró)
    const t = totals();
    if (method==='tarjeta' && card==='4000000000000002'){
      state.lastError = {code:'DECLINED', title:'Pago rechazado', msg:'Tu banco rechazó la transacción por fondos insuficientes. No se realizó ningún cargo.', hint:'Prueba con otra tarjeta o elige pagar en efectivo.'};
      location.hash = '#/error'; return;
    }
    if (method==='tarjeta' && card==='4000000000000119'){
      state.lastError = {code:'NETWORK', title:'No pudimos conectar con el banco', msg:'Hubo un problema de conexión al procesar el pago. Tu pedido sigue guardado y no se hizo ningún cargo.', hint:'Espera unos segundos e inténtalo de nuevo.', retry:true};
      location.hash = '#/error'; return;
    }
    const code = 'LC-' + Date.now().toString().slice(-6);
    state.lastOrder = {code, items:JSON.parse(JSON.stringify(state.cart)), totals:t, order:{...state.order}, method, coupon:state.coupon, card: method==='tarjeta' ? brand(card)+' •••• '+card.slice(-4) : null, at:new Date()};
    PRODUCTS.forEach(p => { const used = stockUsed(p.id); p.stock = Math.max(0, p.stock - used); });
    state.cart = []; state.coupon = null; state.order = {nombre:state.order.nombre, tel:state.order.tel, email:state.order.email};
    save(); updateBadge(); fPago.reset(); $('#c-num').dispatchEvent(new Event('input')); $('#c-name').dispatchEvent(new Event('input')); $('#ccExp').textContent='MM/AA';
    location.hash = '#/exito';
  }, 2300);
}

/* ======================= RESULTADOS ======================= */
function fmtDate(iso){ if(!iso) return ''; return new Date(iso+'T12:00').toLocaleDateString('es-SV',{weekday:'long',day:'numeric',month:'long'}); }
function renderSuccess(){
  const L = state.lastOrder, o = L.order, t = L.totals;
  $('#exito').innerHTML = `<div class="result ok">
    <div class="icon">${icons.ok}</div>
    <h1>¡Pedido confirmado!</h1>
    <p class="lead">Gracias, ${esc(o.nombre.split(' ')[0])}. Enviamos el comprobante a <b>${esc(o.email)}</b>.</p>
    <div class="timeline"><div class="on"><i></i>Recibido</div><div><i></i>En el horno</div><div><i></i>${o.metodo==='tienda'?'Listo para retirar':'En camino'}</div><div><i></i>Entregado</div></div>
    <div class="card ticket">
      <div class="head"><div><div style="color:var(--gris);font-size:.85rem">Número de pedido</div><div class="code">${L.code}</div></div>
        <div style="text-align:right"><div style="color:var(--gris);font-size:.85rem">${o.metodo==='tienda'?'Retiro en tienda':'Entrega a domicilio'}</div><b>${fmtDate(o.fecha)}</b><div style="font-size:.9rem">${o.hora}</div></div></div>
      ${L.items.map(l=>`<div class="mini"><span>${l.qty} × ${esc(l.name)} · ${l.sizeLabel}${l.msg?` · “${esc(l.msg)}”`:''}</span><span>${money(r2(l.price*l.qty))}</span></div>`).join('')}
      <div style="border-top:1px solid var(--linea);margin-top:10px;padding-top:10px">
        <div class="mini"><span>Subtotal</span><span>${money(t.sub)}</span></div>
        ${t.disc?`<div class="mini"><span>Cupón ${L.coupon}</span><span style="color:var(--exito)">−${money(t.disc)}</span></div>`:''}
        <div class="mini"><span>Envío</span><span>${t.envio?money(t.envio):'Gratis'}</span></div>
        <div class="mini" style="font-weight:700;font-size:1.05rem"><span style="color:var(--tinta)">Total ${L.method==='tarjeta'?'pagado':'a pagar'}</span><span>${money(t.total)}</span></div>
        <div class="mini"><span>IVA incluido</span><span>${money(t.iva)}</span></div>
        <div class="mini"><span>Método de pago</span><span>${L.card || (o.metodo==='tienda'?'Pago en tienda':'Efectivo contra entrega')}</span></div>
        ${o.metodo==='domicilio'?`<div class="mini"><span>Dirección</span><span style="text-align:right">${esc(o.dir)}, ${esc(o.muni)}</span></div>`:''}
      </div>
    </div>
    <div class="actions"><a href="#/" class="btn btn-primary">Volver al inicio</a><button class="btn btn-ghost" onclick="window.print()">Imprimir comprobante</button></div>
  </div>`;
}
function renderError(){
  const E = state.lastError;
  $('#errorBox').innerHTML = `<div class="result bad">
    <div class="icon">${icons.err}</div>
    <h1>${E.title}</h1>
    <p class="lead">${E.msg}</p>
    ${alertHTML('warn', E.hint)}
    <div class="card panel" style="text-align:left;margin:20px 0">${summaryHTML({items:true})}</div>
    <div class="actions">
      <a href="#/pago" class="btn btn-accent">${E.retry?'Reintentar pago':'Usar otro método de pago'}</a>
      <a href="#/carrito" class="btn btn-ghost">Revisar carrito</a>
    </div>
    <p style="font-size:.8rem;color:var(--gris);margin-top:16px">Código de referencia: ${E.code}-${Date.now().toString().slice(-5)}</p>
  </div>`;
}

/* ======================= ROUTER ======================= */
function show(id){ $$('.screen').forEach(s=>s.classList.toggle('active', s.id===id)); window.scrollTo(0,0); }
function route(){
  const h = location.hash.replace(/^#\/?/,'');
  const [view, param] = h.split('/');
  if (view==='producto'){ renderDetail(param); return show('s-detalle'); }
  if (view==='carrito'){ renderCart(); return show('s-carrito'); }
  if (view==='datos'){
    if (!state.cart.length){ toast('Agrega productos antes de continuar.','error'); location.replace('#/carrito'); return; }
    initDatos(); return show('s-datos');
  }
  if (view==='pago'){
    if (!state.cart.length){ toast('Tu carrito está vacío.','error'); location.replace('#/carrito'); return; }
    if (!state.order.ok){ toast('Completa primero los datos de entrega.','error'); location.replace('#/datos'); return; }
    if (totals().couponError){ toast('Hay un problema con tu cupón. Revísalo en el carrito.','error'); location.replace('#/carrito'); return; }
    initPago(); return show('s-pago');
  }
  if (view==='exito'){ if(!state.lastOrder){ location.replace('#/'); return; } renderSuccess(); return show('s-exito'); }
  if (view==='error'){ if(!state.lastError){ location.replace('#/pago'); return; } renderError(); return show('s-error'); }
  if (view && view.startsWith('catalogo')) return;
  renderCatalog(); show('s-catalogo');
}
document.addEventListener('click', e => {
  const a = e.target.closest('[data-scroll]');
  if (a){ e.preventDefault(); if (!$('#s-catalogo').classList.contains('active')) location.hash='#/'; setTimeout(()=>$('#'+a.dataset.scroll).scrollIntoView({behavior:'smooth'}),60); }
  const anc = e.target.closest('a[href="#catalogo"]');
  if (anc){ e.preventDefault(); $('#catalogo').scrollIntoView({behavior:'smooth'}); }
});
window.addEventListener('hashchange', route);
renderSteppers(); updateBadge(); route();
</script>
</body>
</html>
