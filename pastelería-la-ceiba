<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pastelería La Ceiba</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --verde:#1F4D3A; --verde-2:#2E6B4F; --verde-claro:#E4EEE7;
  --crema:#FBF6EE; --papel:#FFFFFF; --caramelo:#C9853F; --caramelo-2:#A96B2C;
  --rosa:#F2D3C4; --tinta:#1E1B16; --gris:#6E675C; --linea:#E8DFD0;
  --error:#B3261E; --error-bg:#FDECEA; --exito:#1E7D4F; --exito-bg:#E6F4EC;
  --aviso:#8A5A00; --aviso-bg:#FFF4D6;
  --radio:16px; --sombra:0 1px 2px rgba(30,27,22,.06),0 8px 24px rgba(30,27,22,.06);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--crema);color:var(--tinta);font-family:"DM Sans",system-ui,sans-serif;font-size:16px;line-height:1.5}
h1,h2,h3{font-family:"Fraunces",Georgia,serif;line-height:1.15;margin:0 0 .4em;letter-spacing:-.01em}
a{color:inherit}
button{font:inherit;cursor:pointer}
.wrap{max-width:1160px;margin:0 auto;padding:0 16px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* Topbar */
.topbar{position:sticky;top:0;z-index:30;background:rgba(251,246,238,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--linea)}
.topbar-in{display:flex;align-items:center;gap:16px;height:68px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand svg{width:40px;height:40px}
.brand b{font-family:"Fraunces",serif;font-size:1.25rem;color:var(--verde);display:block;line-height:1}
.brand small{color:var(--gris);font-size:.78rem}
.nav{margin-left:auto;display:flex;gap:4px;align-items:center}
.nav a{text-decoration:none;padding:8px 12px;border-radius:999px;color:var(--gris);font-weight:500}
.nav a:hover{background:var(--verde-claro);color:var(--verde)}
.cart-btn{position:relative;display:flex;align-items:center;gap:8px;background:var(--verde);color:#fff;border:0;border-radius:999px;padding:10px 16px;font-weight:700}
.cart-btn:hover{background:var(--verde-2)}
.badge{background:var(--caramelo);color:#fff;border-radius:999px;min-width:22px;height:22px;display:inline-grid;place-items:center;font-size:.78rem;padding:0 6px}
.badge.bump{animation:bump .35s}
@keyframes bump{50%{transform:scale(1.35)}}
@media (max-width:640px){.nav a{display:none}.brand small{display:none}}

/* Buttons & inputs */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:13px 20px;font-weight:700;text-decoration:none;transition:.15s}
.btn-primary{background:var(--verde);color:#fff}.btn-primary:hover{background:var(--verde-2)}
.btn-accent{background:var(--caramelo);color:#fff}.btn-accent:hover{background:var(--caramelo-2)}
.btn-ghost{background:transparent;color:var(--verde);border:1.5px solid var(--linea)}.btn-ghost:hover{border-color:var(--verde)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.btn-block{width:100%}
.link{background:none;border:0;color:var(--verde);font-weight:700;padding:0;text-decoration:underline;text-underline-offset:3px}
.field{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.field label{font-weight:500;font-size:.92rem}
.field .opt{color:var(--gris);font-weight:400}
input,select,textarea{font:inherit;padding:12px 14px;border:1.5px solid var(--linea);border-radius:10px;background:#fff;color:var(--tinta);width:100%}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--verde);box-shadow:0 0 0 3px var(--verde-claro)}
.field.invalid input,.field.invalid select,.field.invalid textarea{border-color:var(--error);background:var(--error-bg)}
.field .err{color:var(--error);font-size:.84rem;display:none}
.field.invalid .err{display:block}
.field.valid input{border-color:#9CC7AE}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:560px){.row{grid-template-columns:1fr}}

/* Screens */
.screen{display:none;padding:28px 0 64px;animation:fade .25s ease}
.screen.active{display:block}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1}}
.card{background:var(--papel);border:1px solid var(--linea);border-radius:var(--radio);box-shadow:var(--sombra)}
.crumbs{color:var(--gris);font-size:.9rem;margin-bottom:16px}
.crumbs a{text-decoration:none;color:var(--verde);font-weight:500}

/* Hero */
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:24px;align-items:center;background:var(--verde);color:#fff;border-radius:24px;padding:40px;overflow:hidden;position:relative;margin-bottom:32px}
.hero h1{font-size:clamp(2rem,4.5vw,3.2rem)}
.hero p{color:#D6E6DC;max-width:46ch;font-size:1.05rem}
.hero .pills{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0 22px}
.hero .pill{background:rgba(255,255,255,.12);padding:6px 12px;border-radius:999px;font-size:.88rem}
.hero-art{display:grid;place-items:center}
.hero-art svg{width:100%;max-width:340px}
@media (max-width:780px){.hero{grid-template-columns:1fr;padding:28px 22px}.hero-art{display:none}}

/* Catalog */
.cat-head{display:flex;flex-wrap:wrap;gap:12px;align-items:end;justify-content:space-between;margin-bottom:18px}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1.5px solid var(--linea);background:#fff;border-radius:999px;padding:8px 14px;font-weight:500;color:var(--gris)}
.chip.on{background:var(--verde);border-color:var(--verde);color:#fff}
.search{max-width:260px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
.prod{display:flex;flex-direction:column;overflow:hidden;transition:transform .15s, box-shadow .15s;cursor:pointer}
.prod:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(30,27,22,.1)}
.prod .art{background:var(--rosa);aspect-ratio:5/4;display:grid;place-items:center;position:relative}
.prod .art svg{width:72%}
.prod .tag{position:absolute;top:12px;left:12px;background:#fff;color:var(--verde);font-size:.75rem;font-weight:700;padding:4px 10px;border-radius:999px}
.prod .tag.out{background:var(--tinta);color:#fff}
.prod .body{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
.prod h3{font-size:1.15rem;margin:0}
.prod .desc{color:var(--gris);font-size:.9rem;margin:0;flex:1}
.prod .foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.price{font-weight:700;font-size:1.1rem;color:var(--verde)}
.price small{font-weight:400;color:var(--gris);font-size:.8rem}
.prod.soldout .art{filter:grayscale(.7);opacity:.75}
.empty-search{padding:40px;text-align:center;color:var(--gris)}

/* Detail */
.detail{display:grid;grid-template-columns:1fr 1fr;gap:32px}
.detail .art{background:var(--rosa);border-radius:24px;display:grid;place-items:center;aspect-ratio:1/1}
.detail .art svg{width:70%}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:8px 0 18px}
.opt-size{border:1.5px solid var(--linea);background:#fff;border-radius:12px;padding:12px;text-align:left}
.opt-size b{display:block}
.opt-size span{color:var(--gris);font-size:.85rem}
.opt-size em{font-style:normal;color:var(--verde);font-weight:700;display:block;margin-top:4px}
.opt-size.on{border-color:var(--verde);background:var(--verde-claro);box-shadow:0 0 0 2px var(--verde) inset}
.qty{display:inline-flex;align-items:center;border:1.5px solid var(--linea);border-radius:12px;background:#fff;overflow:hidden}
.qty button{width:42px;height:44px;border:0;background:#fff;font-size:1.2rem;color:var(--verde)}
.qty button:hover:not([disabled]){background:var(--verde-claro)}
.qty button[disabled]{color:#C9C2B6;cursor:not-allowed}
.qty input{width:52px;border:0;text-align:center;font-weight:700;padding:0;height:44px}
.qty input:focus{box-shadow:none}
.qty.sm button{width:34px;height:36px}.qty.sm input{width:40px;height:36px}
.calc{background:var(--crema);border:1px dashed var(--linea);border-radius:12px;padding:14px 16px;margin:18px 0;display:grid;gap:4px}
.calc div{display:flex;justify-content:space-between}
.calc .big{font-size:1.25rem;font-weight:700;color:var(--verde);border-top:1px solid var(--linea);padding-top:8px;margin-top:4px}
.stock{font-size:.88rem;display:inline-flex;gap:6px;align-items:center;margin-bottom:8px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--exito)}
.stock.low .dot{background:var(--caramelo)}.stock.out .dot{background:var(--error)}
@media (max-width:780px){.detail{grid-template-columns:1fr}}

/* Stepper */
.stepper{display:flex;gap:6px;margin-bottom:24px;overflow-x:auto;padding-bottom:4px}
.step{flex:1;min-width:110px;display:flex;align-items:center;gap:8px;color:var(--gris);font-size:.88rem;font-weight:500}
.step .n{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--linea);background:#fff;font-weight:700;flex:none}
.step::after{content:"";flex:1;height:2px;background:var(--linea);border-radius:2px}
.step:last-child::after{display:none}
.step.done .n{background:var(--verde);border-color:var(--verde);color:#fff}
.step.done::after{background:var(--verde)}
.step.now{color:var(--tinta)}.step.now .n{border-color:var(--verde);color:var(--verde);box-shadow:0 0 0 3px var(--verde-claro)}

/* Layout two col */
.two{display:grid;grid-template-columns:1fr 380px;gap:24px;align-items:start}
@media (max-width:900px){.two{grid-template-columns:1fr}}
.panel{padding:22px}
.panel h2{font-size:1.4rem}
.sticky{position:sticky;top:88px}

/* Cart lines */
.line{display:grid;grid-template-columns:76px 1fr auto;gap:14px;padding:16px 0;border-bottom:1px solid var(--linea);align-items:center}
.line:last-child{border-bottom:0}
.line .thumb{background:var(--rosa);border-radius:12px;aspect-ratio:1;display:grid;place-items:center}
.line .thumb svg{width:80%}
.line h3{font-size:1.02rem;margin:0}
.line .meta{color:var(--gris);font-size:.85rem}
.line .ctrl{display:flex;align-items:center;gap:12px;margin-top:8px;flex-wrap:wrap}
.line .cost{text-align:right}
.line .cost b{display:block;font-size:1.05rem}
.line .cost span{color:var(--gris);font-size:.82rem}
.remove{background:none;border:0;color:var(--error);font-size:.85rem;font-weight:500;padding:4px 0}
@media (max-width:520px){.line{grid-template-columns:60px 1fr}.line .cost{grid-column:2;text-align:left}}

/* Summary */
.sum-row{display:flex;justify-content:space-between;padding:6px 0;color:var(--gris)}
.sum-row b{color:var(--tinta);font-weight:500}
.sum-row.disc b{color:var(--exito)}
.sum-total{display:flex;justify-content:space-between;align-items:baseline;border-top:1.5px solid var(--linea);margin-top:8px;padding-top:12px}
.sum-total span{font-weight:700}
.sum-total b{font-family:"Fraunces",serif;font-size:1.8rem;color:var(--verde)}
.sum-note{font-size:.8rem;color:var(--gris);margin-top:4px}
.mini{display:flex;justify-content:space-between;font-size:.9rem;padding:4px 0;gap:10px}
.mini span:first-child{color:var(--gris)}
.coupon{display:flex;gap:8px;margin:14px 0 6px}
.coupon input{text-transform:uppercase}
.coupon .btn{padding:10px 14px}

/* Alerts */
.alert{display:flex;gap:10px;align-items:flex-start;padding:12px 14px;border-radius:12px;font-size:.9rem;margin:10px 0}
.alert svg{flex:none;width:20px;height:20px;margin-top:1px}
.alert.error{background:var(--error-bg);color:var(--error)}
.alert.ok{background:var(--exito-bg);color:var(--exito)}
.alert.info{background:var(--verde-claro);color:var(--verde)}
.alert.warn{background:var(--aviso-bg);color:var(--aviso)}

/* Radio cards */
.choices{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.choice{position:relative}
.choice input{position:absolute;opacity:0}
.choice label{display:flex;gap:12px;align-items:flex-start;border:1.5px solid var(--linea);border-radius:12px;padding:14px;background:#fff;cursor:pointer;height:100%}
.choice label b{display:block}
.choice label span{color:var(--gris);font-size:.85rem}
.choice input:checked + label{border-color:var(--verde);background:var(--verde-claro);box-shadow:0 0 0 2px var(--verde) inset}
.choice input:focus-visible + label{outline:3px solid var(--verde-claro)}
.choice .ico{width:36px;height:36px;border-radius:10px;background:#fff;display:grid;place-items:center;flex:none;border:1px solid var(--linea)}
@media (max-width:560px){.choices{grid-template-columns:1fr}}
fieldset{border:0;padding:0;margin:0 0 6px}
legend{font-family:"Fraunces",serif;font-size:1.15rem;font-weight:700;margin-bottom:10px}

/* Card preview */
.cc{background:linear-gradient(135deg,var(--verde),#14362A);color:#fff;border-radius:16px;padding:20px;aspect-ratio:1.6/1;max-width:340px;display:flex;flex-direction:column;justify-content:space-between;margin-bottom:18px;position:relative;overflow:hidden}
.cc::after{content:"";position:absolute;right:-40px;top:-40px;width:160px;height:160px;border-radius:50%;background:rgba(201,133,63,.35)}
.cc .num{font-size:1.25rem;letter-spacing:.12em;font-variant-numeric:tabular-nums}
.cc .bot{display:flex;justify-content:space-between;font-size:.82rem;text-transform:uppercase}
.cc .chipc{width:38px;height:28px;border-radius:6px;background:#E3C27A}
.testcards{font-size:.84rem;background:var(--aviso-bg);color:var(--aviso);border-radius:12px;padding:12px 14px;margin-bottom:16px}
.testcards code{background:#fff;padding:2px 6px;border-radius:6px;cursor:pointer;color:var(--tinta);display:inline-block;margin:2px 0}
.secure{display:flex;gap:6px;align-items:center;color:var(--gris);font-size:.82rem;justify-content:center;margin-top:10px}

/* Result */
.result{max-width:680px;margin:0 auto;text-align:center}
.result .icon{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px}
.result.ok .icon{background:var(--exito-bg);color:var(--exito)}
.result.bad .icon{background:var(--error-bg);color:var(--error)}
.result .icon svg{width:42px;height:42px}
.result h1{font-size:clamp(1.8rem,4vw,2.4rem)}
.result p.lead{color:var(--gris);font-size:1.05rem}
.ticket{text-align:left;margin:24px 0;padding:22px}
.ticket .head{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;border-bottom:1.5px dashed var(--linea);padding-bottom:12px;margin-bottom:12px}
.ticket .code{font-family:"Fraunces",serif;font-size:1.3rem;color:var(--verde)}
.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.timeline{display:flex;justify-content:space-between;margin:18px 0 6px;position:relative}
.timeline::before{content:"";position:absolute;top:13px;left:10%;right:10%;height:2px;background:var(--linea)}
.timeline div{position:relative;flex:1;text-align:center;font-size:.8rem;color:var(--gris)}
.timeline i{display:block;width:28px;height:28px;border-radius:50%;margin:0 auto 6px;background:#fff;border:2px solid var(--linea)}
.timeline .on i{background:var(--exito);border-color:var(--exito)}
.timeline .on{color:var(--tinta);font-weight:500}

/* Empty */
.empty{text-align:center;padding:56px 20px}
.empty svg{width:120px;margin-bottom:12px}
.empty p{color:var(--gris)}

/* Overlay processing */
.overlay{position:fixed;inset:0;background:rgba(30,27,22,.55);display:none;place-items:center;z-index:60;padding:16px}
.overlay.on{display:grid}
.proc{background:#fff;border-radius:20px;padding:32px;max-width:360px;width:100%;text-align:center}
.spinner{width:56px;height:56px;border-radius:50%;border:5px solid var(--verde-claro);border-top-color:var(--verde);animation:spin .9s linear infinite;margin:0 auto 18px}
@keyframes spin{to{transform:rotate(360deg)}}
.proc-steps{text-align:left;margin-top:16px;font-size:.9rem;color:var(--gris);display:grid;gap:6px}
.proc-steps .d{color:var(--exito)}

/* Toast */
.toasts{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);display:grid;gap:8px;z-index:70;width:min(420px,calc(100% - 32px))}
.toast{background:var(--tinta);color:#fff;border-radius:12px;padding:12px 16px;display:flex;gap:10px;align-items:center;box-shadow:0 10px 30px rgba(0,0,0,.25);animation:up .25s ease}
.toast.error{background:var(--error)}.toast.ok{background:var(--exito)}
.toast button{margin-left:auto;background:rgba(255,255,255,.15);border:0;color:#fff;border-radius:8px;padding:6px 10px;font-weight:700}
@keyframes up{from{opacity:0;transform:translateY(10px)}}

/* Footer */
footer{background:var(--verde);color:#D6E6DC;padding:36px 0;margin-top:20px}
footer .cols{display:grid;grid-template-columns:2fr 1fr 1fr;gap:24px}
footer b{color:#fff;font-family:"Fraunces",serif;font-size:1.1rem}
footer p{margin:6px 0;font-size:.9rem}
@media (max-width:700px){footer .cols{grid-template-columns:1fr}}

/* Print receipt */
@media print{
  .topbar,footer,.actions,.stepper,.toasts{display:none!important}
  body{background:#fff}
  .screen{display:none!important}#s-exito{display:block!important}
  .card{box-shadow:none}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="wrap topbar-in">
    <a href="#/" class="brand" aria-label="Pastelería La Ceiba, inicio">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <circle cx="24" cy="24" r="23" fill="#1F4D3A"/>
        <path d="M22.5 40v-11c-2-1.5-4.5-3-7-3.2M25.5 40v-11c2-1.5 4.5-3 7-3.2M24 30v-9" stroke="#C9853F" stroke-width="2.4" stroke-linecap="round" fill="none"/>
        <ellipse cx="24" cy="16" rx="14" ry="6" fill="#7FB394"/>
        <ellipse cx="15" cy="19" rx="6" ry="3.5" fill="#5E9A77"/>
        <ellipse cx="33" cy="19" rx="6" ry="3.5" fill="#5E9A77"/>
        <rect x="14" y="39" width="20" height="2.5" rx="1.25" fill="#C9853F"/>
      </svg>
      <span><b>La Ceiba</b><small>Pastelería artesanal</small></span>
    </a>
    <nav class="nav" aria-label="Principal">
      <a href="#/">Catálogo</a>
      <a href="#/" data-scroll="como">Cómo comprar</a>
      <button class="cart-btn" id="cartBtn" aria-label="Ver carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
        <span class="hide-sm">Carrito</span>
        <span class="badge" id="cartCount">0</span>
      </button>
    </nav>
  </div>
</header>

<main class="wrap">

  <!-- ============ CATÁLOGO ============ -->
  <section class="screen" id="s-catalogo" aria-labelledby="t-cat">
    <div class="hero">
      <div>
        <h1>Hecho a mano,<br>como en casa.</h1>
        <p>Pasteles, pan dulce y postres horneados cada mañana. Encarga en línea y recógelo en tienda o recíbelo en tu puerta.</p>
        <div class="pills"><span class="pill">🎂 Pasteles por encargo</span><span class="pill">🚚 Envío gratis desde $40</span><span class="pill">✍️ Dedicatoria sin costo</span></div>
        <a href="#catalogo" class="btn btn-accent">Ver el catálogo</a>
      </div>
      <div class="hero-art" id="heroArt"></div>
    </div>

    <div class="cat-head" id="catalogo">
      <div>
        <h2 id="t-cat" style="font-size:1.8rem;margin:0">Nuestro catálogo</h2>
        <span style="color:var(--gris)">Precios en USD, IVA incluido.</span>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        <div class="chips" id="chips" role="tablist" aria-label="Filtrar por categoría"></div>
        <input class="search" id="search" type="search" placeholder="Buscar…" aria-label="Buscar producto">
      </div>
    </div>
    <div class="grid" id="grid"></div>

    <div class="card panel" id="como" style="margin-top:40px">
      <h2>Cómo comprar</h2>
      <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
        <div><b>1. Elige</b><p style="color:var(--gris);margin:4px 0">Selecciona producto, tamaño y cantidad.</p></div>
        <div><b>2. Revisa tu carrito</b><p style="color:var(--gris);margin:4px 0">Ajusta cantidades y aplica cupones.</p></div>
