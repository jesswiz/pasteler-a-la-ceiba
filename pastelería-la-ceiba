};
$('#c-name').oninput = e => $('#ccName').textContent = e.target.value.toUpperCase() || 'NOMBRE DEL TITULAR';
$('#c-exp').oninput = e => { let v=e.target.value.replace(/\D/g,'').slice(0,4); if(v.length>2) v=v.slice(0,2)+'/'+v.slice(2); e.target.value=v; $('#ccExp').textContent = v || 'MM/AA'; };
$('#c-cvv').oninput = e => e.target.value = e.target.value.replace(/\D/g,'').slice(0,4);
$$('.testcards code').forEach(c => c.onclick = () => {
