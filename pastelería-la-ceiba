/* ======================= DETALLE ======================= */
function renderDetail(id){
  const p = byId(id);
  if (!p){ $('#detalle').innerHTML = `<div class="empty card">${alertHTML('error','El producto que buscas no existe o fue retirado.')}<a href="#/" class="btn btn-primary">Ir al catálogo</a></div>`; return; }
  const d = state.detail;
  if (!d.size || d.pid !== id){ state.detail = {pid:id, size:p.sizes[0].id, qty:1, msg:''}; }
  draw();
  function draw(){
    const d = state.detail, s = p.sizes.find(x=>x.id===d.size);
    const avail = Math.max(0, p.stock - stockUsed(p.id));
    const out = p.stock === 0, noneLeft = !out && avail === 0;
    const over = d.qty > avail;
    const stockCls = out ? 'out' : p.stock<=3 ? 'low' : '';
    const stockTxt = out ? 'Agotado por hoy' : p.stock<=3 ? `¡Últimas ${p.stock} unidades!` : `Disponible · ${p.stock} en existencia`;
    $('#detalle').innerHTML = `
      <div class="crumbs"><a href="#/">Catálogo</a> / ${p.cat} / ${p.name}</div>
      <div class="detail">
        <div class="art">${art(p)}</div>
        <div>
          <span class="stock ${stockCls}"><span class="dot"></span>${stockTxt}</span>
          <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">${p.name}</h1>
          <p style="color:var(--gris);font-size:1.05rem">${p.desc}</p>
          ${out ? alertHTML('error','<b>Producto agotado.</b> No es posible agregarlo al carrito en este momento. Te sugerimos el Cheesecake de Fresa.') : ''}
          ${noneLeft ? alertHTML('warn','Ya tienes en tu carrito todas las unidades disponibles de este producto.') : ''}
          <h3 style="font-size:1.05rem;margin-top:18px">Tamaño</h3>
          <div class="opts" role="radiogroup" aria-label="Tamaño">
            ${p.sizes.map(x=>`<button class="opt-size ${x.id===d.size?'on':''}" role="radio" aria-checked="${x.id===d.size}" data-size="${x.id}" ${out?'disabled':''}><b>${x.label}</b><span>${x.detail}</span><em>${money(x.price)}</em></button>`).join('')}
          </div>
          ${p.msg && s.id!=='p' ? `<div class="field"><label for="d-msg">Dedicatoria en el pastel <span class="opt">(opcional, sin costo)</span></label><input id="d-msg" maxlength="30" placeholder="¡Feliz cumpleaños, Ana!" value="${esc(d.msg)}"><span style="font-size:.8rem;color:var(--gris)" id="msgCount">${d.msg.length}/30</span></div>`:''}
          <h3 style="font-size:1.05rem">Cantidad</h3>
          <div class="qty" aria-label="Cantidad">
            <button id="qMinus" aria-label="Restar" ${d.qty<=1||out?'disabled':''}>−</button>
            <input id="qInput" type="number" min="1" value="${d.qty}" aria-label="Cantidad" ${out?'disabled':''}>
            <button id="qPlus" aria-label="Sumar" ${d.qty>=avail||out?'disabled':''}>+</button>
          </div>
          ${over && !out && !noneLeft ? `<div class="alert error" style="margin-top:10px">${icons.err}<div>Solo quedan <b>${avail}</b> unidades disponibles.</div></div>`:''}
          <div class="calc" aria-live="polite">
            <div><span>Precio unitario</span><span>${money(s.price)}</span></div>
            <div><span>Cantidad</span><span>× ${d.qty}</span></div>
            <div class="big"><span>Costo</span><span>${money(r2(s.price*d.qty))}</span></div>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn btn-primary" id="addBtn" style="flex:1" ${out||noneLeft||over?'disabled':''}>Agregar al carrito</button>
            <button class="btn btn-ghost" id="buyBtn" ${out||noneLeft||over?'disabled':''}>Comprar ahora</button>
          </div>
          <p style="font-size:.85rem;color:var(--gris);margin-top:12px">Pasteles medianos y grandes se preparan con al menos 24 horas de anticipación.</p>
        </div>
      </div>`;
    $$('.opt-size').forEach(b => b.onclick = () => { state.detail.size = b.dataset.size; draw(); });
    const m = $('#d-msg'); if (m) m.oninput = e => { state.detail.msg = e.target.value; $('#msgCount').textContent = e.target.value.length+'/30'; };
    $('#qMinus').onclick = () => { state.detail.qty = Math.max(1, d.qty-1); draw(); };
    $('#qPlus').onclick = () => { state.detail.qty = d.qty+1; draw(); };
    $('#qInput').onchange = e => { const v = parseInt(e.target.value,10); state.detail.qty = isNaN(v)||v<1 ? 1 : v; draw(); };
    $('#addBtn').onclick = () => add(false);
    $('#buyBtn').onclick = () => add(true);
  }
  function add(go){
    const d = state.detail, s = p.sizes.find(x=>x.id===d.size);
    const msg = (p.msg && s.id!=='p') ? d.msg.trim() : '';
    const key = p.id+'|'+s.id+'|'+msg;
    const avail = p.stock - stockUsed(p.id);
    if (d.qty > avail){ toast(`Solo quedan ${avail} unidades disponibles.`,'error'); return; }
    const ex = state.cart.find(l=>l.key===key);
    if (ex) ex.qty += d.qty;
    else state.cart.push({key, id:p.id, name:p.name, size:s.id, sizeLabel:s.label, detail:s.detail, price:s.price, qty:d.qty, msg});
    save(); updateBadge(true);
    state.detail.qty = 1;
    if (go) location.hash = '#/carrito';
    else { toast(`${p.name} (${s.label}) agregado al carrito`,'ok',{label:'Ver carrito',fn:()=>location.hash='#/carrito'}); draw(); }
  }
}

