  return `
    <h2 style="font-size:1.25rem">Resumen del pedido</h2>
    ${opts.items ? `<div style="border-bottom:1px solid var(--linea);padding-bottom:10px;margin-bottom:10px">${state.cart.map(l=>`<div class="mini"><span>${l.qty} × ${esc(l.name)} · ${l.sizeLabel}</span><span>${money(r2(l.price*l.qty))}</span></div>`).join('')}</div>` : ''}
    <div class="sum-row"><span>Subtotal (${t.count} ${t.count===1?'artículo':'artículos'})</span><b>${money(t.sub)}</b></div>
    ${t.disc ? `<div class="sum-row disc"><span>Cupón ${state.coupon}</span><b>−${money(t.disc)}</b></div>`:''}
