      <h2>Tu carrito está vacío</h2><p>Aún no has agregado nada. ¡Nuestro tres leches te está esperando!</p>
      <a href="#/" class="btn btn-primary">Explorar el catálogo</a></div>`;
    return;
  }
  $('#carrito').innerHTML = `<div class="two">
    <div class="card panel">
      <div style="display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px"><h2>Tu carrito</h2><button class="link" id="emptyCart" style="color:var(--error)">Vaciar carrito</button></div>
